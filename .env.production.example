# Production env — set in Vercel (Web + API). Never commit real secrets.

NODE_ENV=production
APP_NAME=NVR.io

# Web (Vercel)
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# API
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# REQUIRED: Postgres (Neon free tier works with Vercel)
# SQLite will NOT work on Vercel serverless
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
FIELD_ENCRYPTION_KEY=

# Cloudflare R2
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nvr-io-uploads
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

DEFAULT_LOAN_AMOUNT=1800
DEFAULT_DAILY_PAYMENT=100
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# WhatsApp auto receipts — or configure in Settings (Super Admin)
# Free: WHATSAPP_WAHA_URL / WHATSAPP_WAHA_API_KEY / WHATSAPP_WAHA_SESSION (infrastructure/waha)
# CRON_SECRET=
# WHATSAPP_PROVIDER=green-api
# WHATSAPP_TOKEN=
# WHATSAPP_GREEN_ID_INSTANCE=
# WHATSAPP_GREEN_API_URL=https://api.green-api.com
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DEFAULT_COUNTRY=971
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en
