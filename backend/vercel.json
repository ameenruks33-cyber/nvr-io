{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install && npx prisma generate",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/whatsapp/keepalive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/collections/reminders/daily",
      "schedule": "0 14 * * *"
    }
  ]
}
