# Copy to .env and backend/.env for local development
# NEVER commit real secrets

NODE_ENV=development
APP_NAME=NVR.io
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Local Postgres via Docker: npm/docker compose in infrastructure/docker
# DATABASE_URL=postgresql://jithu:jithu_dev_password@localhost:5432/jithu_buy?schema=public
DATABASE_URL=postgresql://jithu:jithu_dev_password@localhost:5432/jithu_buy?schema=public

# Auth (generate strong random values for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AES-256-GCM key: 32 bytes as base64
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Local private document storage (Phase 1)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Future S3-compatible
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=nvr-io-docs
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=me-central-1

# Seed admin (demo only)
SEED_ADMIN_EMAIL=admin@jithubuy.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Super Admin

# CORS
CORS_ORIGINS=http://localhost:3000

# Loan defaults (AED)
DEFAULT_LOAN_AMOUNT=1800
DEFAULT_DAILY_PAYMENT=100

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# WhatsApp auto receipts after collection
# Prefer Settings → WhatsApp auto receipts (Green API). Or set env on the API project:
# WHATSAPP_PROVIDER=green-api
# WHATSAPP_TOKEN=
# WHATSAPP_GREEN_ID_INSTANCE=
# WHATSAPP_GREEN_API_URL=https://api.green-api.com
# Meta alternative:
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_DEFAULT_COUNTRY=971
